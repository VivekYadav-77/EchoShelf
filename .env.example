# Database
DB_USER=echoshelf_admin
DB_PASS=your_password_here

# Security
JWT_SECRET=your_64_char_hex_secret_here
COOKIE_SECURE=false

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here

# 3. CORS Configuration (CRITICAL for avoiding CORS errors)
# This MUST be your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://echoshelf-frontend.vercel.app
